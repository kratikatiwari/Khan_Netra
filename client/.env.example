# ═══════════════════════════════════════════════════════════════════════════
# KhanNetra DGMS — Client Environment Variables
# ───────────────────────────────────────────────────────────────────────────
# Copy this file to .env (development) or .env.production (production build).
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put secrets here.
# ═══════════════════════════════════════════════════════════════════════════

# ── API base URL ─────────────────────────────────────────────────────────────
# Leave empty (or omit) when the frontend and API share the same origin.
# The Vite dev proxy handles /api → http://localhost:5000 automatically.
#
# Only set this when the API lives on a DIFFERENT origin in production:
#   VITE_API_URL=https://api.khannetra.yourdomain.in/api/v1
#
VITE_API_URL=

# ── Backend URL for Vite dev proxy ───────────────────────────────────────────
# Override the proxy target if your backend runs on a different port/host.
# Default: http://localhost:5000
VITE_BACKEND_URL=http://localhost:5000
