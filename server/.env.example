# ═══════════════════════════════════════════════════════════════════════════
# KhanNetra DGMS — Server Environment Variables
# ───────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is already listed in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000

# ── Database (SQLite — these PostgreSQL vars are currently unused) ────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=khannetra
DB_USER=postgres
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────────────────────
# CLIENT_URL   — base URL used to build email verification links.
#   Development:  http://localhost:3000
#   Production:   https://khannetra.yourdomain.in
CLIENT_URL=http://localhost:3000

# DEV_CLIENT_URL — optional override of CLIENT_URL for local/LAN development.
#   Use this when you want verification links to point to a LAN IP
#   WITHOUT changing CLIENT_URL (which you keep as the production value).
#   e.g. DEV_CLIENT_URL=http://192.168.1.100:3000
#   Leave empty to use CLIENT_URL.
DEV_CLIENT_URL=

# ALLOWED_ORIGINS — comma-separated list of CORS-allowed origins.
#   Add your production domain when deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── File uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760        # bytes (10 MB)
UPLOAD_PATH=./uploads

# ── Rate limiting (requests per 15-minute window per IP) ─────────────────────
REGISTER_RATE_LIMIT=10
RESEND_RATE_LIMIT=5
LOGIN_RATE_LIMIT=20

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── AI Safety Vision ─────────────────────────────────────────────────────────
MODEL_BACKEND=gemini          # gemini | yolo_onnx
# YOLO_MODEL_PATH=./models/ppe_yolo.onnx
# YOLO_CONF_THRESHOLD=0.45

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL / SMTP — Transactional email for account verification
# ───────────────────────────────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASS empty to run without email (dev console mode).
#
# OPTION A — Gmail (development / small deployments)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourapp@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   ← 16-char Gmail App Password (spaces ok)
#   SMTP_FROM=KhanNetra DGMS <yourapp@gmail.com>
#   How to get App Password: https://myaccount.google.com/apppasswords
#
# OPTION B — Sendgrid (production recommended)
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
#   SMTP_FROM=KhanNetra DGMS <noreply@yourdomain.in>
#
# OPTION C — Mailgun
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_USER=postmaster@mg.yourdomain.in
#   SMTP_PASS=<mailgun-smtp-password>
#   SMTP_FROM=KhanNetra DGMS <noreply@yourdomain.in>
#
# OPTION D — Amazon SES
#   SMTP_HOST=email-smtp.<region>.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=<AKID>
#   SMTP_PASS=<SES-smtp-secret>
#   SMTP_FROM=KhanNetra DGMS <noreply@yourdomain.in>
#
# OPTION E — Resend
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
#   SMTP_FROM=KhanNetra DGMS <noreply@yourdomain.in>
# ═══════════════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KhanNetra DGMS <>
